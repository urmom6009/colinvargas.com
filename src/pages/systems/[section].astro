---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { systemsSections } from "../../data/systemsSections";

export function getStaticPaths() {
  return Object.entries(systemsSections).map(([section, props]) => ({
    params: { section },
    props: { section, ...props },
  }));
}

const page = Astro.props;
const fallbackJson = JSON.stringify({
  title: page.title,
  sourceKey: page.sourceKey,
}).replace(/</g, "\\u003c");
---

<BaseLayout
  title={`${page.title} systems - colin vargas`}
  description={`${page.title} systems readout for the public colin vargas status surface.`}
>
  <main id="main-content" tabindex="-1">
    <p class="telemetry-notice" data-telemetry-notice role="status">
      live public telemetry is unavailable. no current health values are shown.
    </p>
    <section
      class="resume-hero page-scene systems-detail-hero"
      aria-labelledby="systems-detail-title"
      data-scroll-chapter
    >
      <div class="section-heading">
        <span>{page.eyebrow}</span>
        <span><a href="/systems">back to systems</a></span>
      </div>

      <div class="resume-hero-grid">
        <div>
          <h1 id="systems-detail-title">{page.headline}</h1>
          <p>{page.summary}</p>
        </div>

        <aside class="systems-detail-card">
          <span>readout</span>
          <strong data-detail-metric>unavailable</strong>
          <p data-detail-copy>live readout unavailable.</p>
          <dl class="systems-meta">
            <div>
              <dt>signal</dt>
              <dd><span data-detail-signal>—</span><span data-detail-signal-unit></span></dd>
            </div>
            <div>
              <dt>source</dt>
              <dd data-detail-source>api unavailable</dd>
            </div>
          </dl>
        </aside>
      </div>
    </section>

    <section
      class="resume-section page-scene systems-detail-section"
      aria-labelledby="systems-detail-readout"
      data-scroll-chapter
    >
      <div class="section-heading">
        <span id="systems-detail-readout">readout</span>
        <span>{page.title}</span>
      </div>

      <div class="systems-detail-grid">
        <article
          class="systems-panel systems-detail-primary"
          data-build-step="1"
        >
          <div class="systems-panel-head">
            <span>current readout</span>
            <small data-detail-updated>unavailable</small>
          </div>
          <div
            class="systems-detail-gauge"
            style="--score-angle: 0deg"
            data-detail-gauge
          >
            <span data-detail-signal>—</span>
            <small>signal score</small>
          </div>
          <p>{page.summary}</p>
        </article>

        <article class="systems-panel systems-detail-notes" data-build-step="2">
          <div class="systems-panel-head">
            <span>boundaries</span>
            <small>public boundary</small>
          </div>
          <ul>
            {page.notes.map((note) => <li>{note}</li>)}
          </ul>
        </article>

        <article class="systems-panel systems-detail-live" data-build-step="3">
          <div class="systems-panel-head">
            <span>visible fields</span>
            <small>live api</small>
          </div>
          <div class="systems-detail-live-list" data-detail-live>
            <p>live readout unavailable.</p>
          </div>
        </article>
      </div>
    </section>
  </main>

  <script
    is:inline
    id="systems-detail-fallback"
    type="application/json"
    set:html={fallbackJson}
  />
  <script is:inline>
    (() => {
      const fallback = JSON.parse(
        document.getElementById("systems-detail-fallback")?.textContent || "{}",
      );
      const lower = (value, backup = "unavailable") =>
        String(value ?? backup).toLowerCase();
      const setText = (selector, value) => {
        document.querySelectorAll(selector).forEach((node) => {
          node.textContent = String(value);
        });
      };
      const formatGenerated = (value) => {
        if (!value) return "unavailable";
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return lower(value);
        return new Intl.DateTimeFormat("en", {
          month: "short",
          day: "numeric",
          hour: "2-digit",
          minute: "2-digit",
        })
          .format(date)
          .toLowerCase();
      };
      const clamp = (value) => Math.min(Math.max(Number(value) || 0, 0), 100);
      const renderLiveList = (items) => {
        const target = document.querySelector("[data-detail-live]");
        if (!target) return;
        target.replaceChildren(
          ...items.map(([label, value]) => {
            const row = document.createElement("div");
            const key = document.createElement("span");
            const detail = document.createElement("strong");
            key.textContent = lower(label);
            detail.textContent = lower(value);
            row.append(key, detail);
            return row;
          }),
        );
      };
      const render = (data, source) => {
        const notice = document.querySelector("[data-telemetry-notice]");
        if (notice)
          notice.textContent =
            source === "live api"
              ? "live public telemetry — read-only snapshot from the systems api."
              : "live public telemetry is unavailable. no current health values are shown.";
        const card = (data.cards || []).find((item) =>
          lower(item.label).includes(fallback.title),
        );
        const radar = (data.radar || []).find(
          (item) => lower(item.label) === lower(fallback.sourceKey),
        );
        const score = radar?.value !== null && radar?.value !== undefined && radar?.value !== "" && Number.isFinite(Number(radar.value))
          ? clamp(radar.value)
          : null;
        const metric = lower(card?.value);
        const detail = lower(card?.detail, "live readout unavailable.");
        setText("[data-detail-metric]", metric);
        setText("[data-detail-copy]", detail);
        setText("[data-detail-signal]", score === null ? "—" : score);
        setText("[data-detail-signal-unit]", score === null ? "" : "%");
        setText("[data-detail-source]", source);
        setText("[data-detail-updated]", formatGenerated(data.generated_at));
        document
          .querySelector("[data-detail-gauge]")
          ?.style.setProperty("--score-angle", `${(score ?? 0) * 3.6}deg`);
        renderLiveList([
          ["status", metric],
          ["detail", detail],
          ["signal score", score === null ? "unavailable" : `${score}%`],
          ["source", source],
        ]);
      };
      render({ cards: [], radar: [] }, "api unavailable");
      fetch("/systems/api/public", {
        headers: { accept: "application/json" },
        cache: "no-store",
      })
        .then((response) => {
          if (!response.ok) throw new Error(String(response.status));
          return response.json();
        })
        .then((data) => {
          if (
            !data ||
            typeof data !== "object" ||
            !Array.isArray(data.cards) ||
            !Array.isArray(data.radar)
          ) {
            throw new Error("systems api returned an invalid snapshot");
          }
          render(data, "live api");
        })
        .catch(() => render({ cards: [], radar: [] }, "api unavailable"));
    })();
  </script>
</BaseLayout>
