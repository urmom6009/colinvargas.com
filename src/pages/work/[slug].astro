---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ImplementationExcerpt from "../../components/ImplementationExcerpt.astro";
import { projects, type Project } from "../../data/portfolio";
export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}
interface Props {
  project: Project;
}
const { project } = Astro.props;
const next =
  projects[
    (projects.findIndex((item) => item.slug === project.slug) + 1) %
      projects.length
  ];
---

<BaseLayout
  title={`${project.title} — colin vargas`}
  description={project.summary}
>
  <main id="main-content" tabindex="-1" class="project-detail">
    <section class="page-intro project-intro" aria-labelledby="project-title">
      <div class="section-heading">
        <a href="/work">← all work</a><span
          >{project.number} / {project.discipline}</span
        >
      </div>
      <span
        class:list={["status-label", { "status-published": project.source }]}
        >{project.status}</span
      >
      <h1 id="project-title">
        {project.title}<span class="accent-dot">.</span>
      </h1>
      <div class="intro-bottom">
        <p>{project.summary}</p><div class="project-facts">
          <span>{project.context}</span><span>{project.tools.join(" / ")}</span
          ><span>{project.record}</span>
        </div>
      </div>
    </section>
    <section class="project-overview" aria-labelledby="question-title">
      <div class="project-question">
        <span class="eyebrow">the engineering question</span><h2
          id="question-title"
        >
          {project.question}
        </h2><p>{project.scope}</p>{
          project.source && (
            <a class="button-link" href={project.source}>
              inspect the source <span aria-hidden="true">↗</span>
            </a>
          )
        }
      </div>
      {
        project.slug === "adaptive-cfd-solver" ? (
          <ImplementationExcerpt detailed />
        ) : (
          <aside class="project-brief" aria-label="project scope and methods">
            <span class="eyebrow">scope & methods</span>
            <h2>at a glance.</h2>
            <dl>
              {project.brief.map((item: Project["brief"][number]) => (
                <div>
                  <dt>{item.label}</dt>
                  <dd>{item.value}</dd>
                </div>
              ))}
            </dl>
            <p>{project.record}</p>
          </aside>
        )
      }
    </section>
    <section class="portfolio-section" aria-labelledby="approach-title">
      <div class="section-heading">
        <h2 id="approach-title">approach & scope</h2><span
          >{project.context}</span
        >
      </div>
      <ol class="project-approach">
        {
          project.approach.map(
            (step: Project["approach"][number], index: number) => (
              <li>
                <>
                  <span class="eyebrow">0{index + 1}</span>
                  <h3>{step.title}</h3>
                  <p>{step.detail}</p>
                </>
              </li>
            ),
          )
        }
      </ol>
    </section>
    <section class="evidence-section" aria-labelledby="record-title">
      <div>
        <span class="eyebrow">the public record</span><h2 id="record-title">
          what you can<br />inspect today.
        </h2>
      </div><div>
        <p>{project.evidence}</p>{
          project.source ? (
            <a class="text-link" href={project.source}>
              open the repository <span aria-hidden="true">↗</span>
            </a>
          ) : (
            <a class="text-link" href="/contact">
              discuss this project <span aria-hidden="true">↗</span>
            </a>
          )
        }<div class="next-artifact">
          <span class="eyebrow">next to document</span><p>{project.next}</p>
        </div>
      </div>
    </section>
    <a class="next-project" href={`/work/${next.slug}`}
      ><span class="eyebrow">next project / {next.number}</span><strong
        >{next.title}</strong
      ><span aria-hidden="true">↗</span></a
    >
  </main>
</BaseLayout>
