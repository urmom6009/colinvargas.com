---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectList from "../../components/ProjectList.astro";
import { projects } from "../../data/portfolio";
const filters = [
  { value: "all", label: "all work" },
  { value: "numerics", label: "numerical methods" },
  { value: "propulsion", label: "propulsion" },
  { value: "software", label: "software" },
];
---

<BaseLayout
  title="selected work — colin vargas"
  description="Projects in computational fluid dynamics, propulsion analysis, numerical flow modeling, and engineering software. Scope, approach, and publication status for each."
>
  <main id="main-content" tabindex="-1">
    <section class="page-intro" aria-labelledby="work-title">
      <div class="section-heading">
        <span>the project index</span><span>01—04</span>
      </div>
      <h1 id="work-title">
        curiosity,<br />put to work<span class="accent-dot">.</span>
      </h1>
      <div class="intro-bottom">
        <p>
          computational aerospace and the software around it. explore the
          question, the approach, and the current public record for each
          project.
        </p><p class="intro-note">
          project overviews are available for all four entries. research reports
          and numerical results are marked where they are still forthcoming.
        </p>
      </div>
    </section>
    <section class="work-index" aria-labelledby="project-index-title">
      <div class="filter-bar">
        <h2 id="project-index-title" class="eyebrow">browse the work</h2><div
          class="work-filters"
          data-work-filters
          hidden
          role="group"
          aria-label="filter projects"
        >
          {
            filters.map((filter) => (
              <button
                type="button"
                data-filter={filter.value}
                aria-pressed={filter.value === "all"}
                aria-controls="project-list"
              >
                {filter.label}
              </button>
            ))
          }
        </div><span class="project-count" data-project-count aria-live="polite"
          >{projects.length} projects</span
        >
      </div>
      <ProjectList />
    </section>
    <section class="page-next">
      <span class="eyebrow">interested in the thinking behind a project?</span
      ><a href="/contact"
        >let's get into the details. <span aria-hidden="true">↗</span></a
      >
    </section>
  </main>
</BaseLayout>
<script>
  const filters = document.querySelector<HTMLElement>("[data-work-filters]");
  if (filters) {
    filters.hidden = false;
    const rows = document.querySelectorAll<HTMLElement>(".project-row");
    filters.querySelectorAll<HTMLButtonElement>("button").forEach((button) => {
      button.addEventListener("click", () => {
        filters
          .querySelectorAll("button")
          .forEach((item) =>
            item.setAttribute("aria-pressed", String(item === button)),
          );
        let count = 0;
        rows.forEach((row) => {
          row.hidden =
            button.dataset.filter !== "all" &&
            row.dataset.category !== button.dataset.filter;
          if (!row.hidden) count++;
        });
        const output = document.querySelector("[data-project-count]");
        if (output)
          output.textContent = `${count} ${count === 1 ? "project" : "projects"}`;
      });
    });
  }
</script>
