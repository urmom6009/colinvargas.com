---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectList from "../../components/ProjectList.astro";
import { projects } from "../../data/portfolio";
const filters = [
  { value: "all", label: "all work" },
  { value: "numerics", label: "numerical methods" },
  { value: "propulsion", label: "propulsion" },
  { value: "aerodynamics", label: "aerodynamics" },
  { value: "software", label: "software" },
];
---

<BaseLayout
  title="selected work — colin vargas"
  description="The models I’ve built and the data I’ve worked with, from fuel blends and advection to wind-tunnel measurements."
>
  <main id="main-content" tabindex="-1">
    <section class="page-intro" aria-labelledby="work-title">
      <h1 id="work-title">
        my projects<span class="accent-dot">.</span>
      </h1>
      <div class="intro-bottom">
        <p>
          some of these started with equations and some started with data.
          i’m usually trying to figure out which part of the setup made the
          result move, whether that’s the fuel blend or the way we mounted a wing.
        </p><p class="intro-note">
          here for combustion? <a class="text-link" href="/work/hydrogen-isooctane-equilibrium">start with the fuel blends ↗</a>
        </p>
      </div>
    </section>
    <section class="work-index" aria-labelledby="project-index-title">
      <div class="filter-bar">
        <h2 id="project-index-title" class="eyebrow">browse the work</h2><div
          class="work-filters"
          data-work-filters
          hidden
          role="group"
          aria-label="filter projects"
        >
          {
            filters.map((filter) => (
              <button
                type="button"
                data-filter={filter.value}
                aria-pressed={filter.value === "all"}
                aria-controls="project-list"
              >
                {filter.label}
              </button>
            ))
          }
        </div><span class="project-count" data-project-count aria-live="polite"
          >{projects.length} projects</span
        >
      </div>
      <ProjectList />
    </section>
    <section class="page-next">
      <span class="eyebrow">questions about a project?</span
      ><a href="/contact"
        >get in touch <span aria-hidden="true">↗</span></a
      >
    </section>
  </main>
</BaseLayout>
<script>
  const filters = document.querySelector<HTMLElement>("[data-work-filters]");
  if (filters) {
    filters.hidden = false;
    const rows = document.querySelectorAll<HTMLElement>(".project-row");
    filters.querySelectorAll<HTMLButtonElement>("button").forEach((button) => {
      button.addEventListener("click", () => {
        filters
          .querySelectorAll("button")
          .forEach((item) =>
            item.setAttribute("aria-pressed", String(item === button)),
          );
        let count = 0;
        rows.forEach((row) => {
          row.hidden =
            button.dataset.filter !== "all" &&
            row.dataset.category !== button.dataset.filter;
          if (!row.hidden) count++;
        });
        const output = document.querySelector("[data-project-count]");
        if (output)
          output.textContent = `${count} ${count === 1 ? "project" : "projects"}`;
      });
    });
  }
</script>
