---
import BaseLayout from "../layouts/BaseLayout.astro";
import ImplementationExcerpt from "../components/ImplementationExcerpt.astro";
import ProjectList from "../components/ProjectList.astro";
import ThermalSequence from "../components/ThermalSequence.astro";
import { profile } from "../data/portfolio";
import "../styles/home.css";
---

<BaseLayout
  title="Colin Vargas — computational combustion, CFD & aviation propulsion"
  description="I’m Colin Vargas. I’m looking for a Fall 2027 PhD group working on combustion, CFD, or aviation propulsion. Here’s what I’ve built and what I want to study next."
>
  <main id="main-content" tabindex="-1" class="portfolio-home">
    <section class="home-hero" aria-labelledby="hero-title">
      <div class="home-intro">
        <p class="home-label">aerospace engineering</p>
        <h1 id="hero-title">colin<br />vargas<span class="accent-dot">.</span></h1>
        <p class="home-focus">computational combustion and aviation propulsion.</p>
        <p class="home-bio">
          i love airplanes, and i keep coming back to what goes on inside the
          combustor. when do spray evaporation, turbulent mixing, and finite-rate
          chemistry change the answer you get from a simulation?
        </p>
        <div class="home-actions">
          <a class="button-link" href="#selected-work">explore my work <span aria-hidden="true">↓</span></a>
          <a class="text-link" href="/resume">technical profile <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <ThermalSequence />
      <div class="home-hero-foot">
        <p><span class="research-dot" aria-hidden="true"></span> looking for a fall 2027 PhD group</p>
        <a href="#solver-study">inside my solver <span aria-hidden="true">↓</span></a>
      </div>
    </section>

    <section class="home-section" id="selected-work" aria-labelledby="work-title">
      <div class="home-section-head">
        <h2 id="work-title">selected work<span class="accent-dot">.</span></h2>
        <a class="text-link" href="/work">all projects <span aria-hidden="true">↗</span></a>
      </div>
      <ProjectList featured />
    </section>

    <section class="home-section home-solver" id="solver-study" aria-label="inside my finite-volume solver">
      <ImplementationExcerpt animate />
      <a class="text-link" href="/work/adaptive-cfd-solver#implementation">
        more about my solver <span aria-hidden="true">↗</span>
      </a>
    </section>

    <section class="home-section home-extras" aria-labelledby="beyond-title">
      <div>
        <h2 id="beyond-title">flying and my homelab<span class="accent-dot">.</span></h2>
        <p>i’m learning to fly, and i like tinkering with the server i run at home.</p>
      </div>
      <div class="home-extra-links">
        <a href="/about">a bit about me <span aria-hidden="true">↗</span></a>
        <a href="/systems">check my homelab <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="home-contact" aria-labelledby="contact-title">
      <h2 id="contact-title">i’d love to hear what you’re working on<span class="accent-dot">.</span></h2>
      <a class="button-link" href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a>
    </section>
  </main>
</BaseLayout>
