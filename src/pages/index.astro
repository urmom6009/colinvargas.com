---
import BaseLayout from "../layouts/BaseLayout.astro";
import ImplementationExcerpt from "../components/ImplementationExcerpt.astro";
import ProjectList from "../components/ProjectList.astro";
import { profile } from "../data/portfolio";
---

<BaseLayout>
  <main id="main-content" tabindex="-1" class="portfolio-home">
    <section class="portfolio-hero" aria-labelledby="hero-title">
      <div class="hero-kicker">
        <span>an aerospace engineering portfolio</span><span
          >numerical methods / software / systems</span
        >
      </div>
      <div class="hero-main">
        <div class="hero-identity">
          <h1 id="hero-title">
            colin<br />vargas<span class="accent-dot">.</span>
          </h1>
          <p class="hero-description">
            making sense of flow.<br />building the tools to explore it.
          </p>
          <p class="hero-bio">
            a master's student in aerospace engineering working across
            computational fluid dynamics, propulsion, and scientific software.
          </p>
          <div class="hero-actions">
            <a class="button-link" href="#selected-work"
              >explore the work <span aria-hidden="true">↓</span></a
            ><a class="text-link" href="/about"
              >a little about me <span aria-hidden="true">↗</span></a
            >
          </div>
        </div>
        <div class="hero-study">
          <ImplementationExcerpt animate />
          <a class="study-reference" href="/work/adaptive-cfd-solver"
            ><span>current research</span><strong
              >read the solver overview</strong
            ><span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
      <div class="hero-index">
        <span
          ><i aria-hidden="true"></i> current focus: amrex-based solver development</span
        ><a href="#selected-work"
          >01 — selected work <span aria-hidden="true">↓</span></a
        >
      </div>
    </section>
    <section
      class="portfolio-section selected-work"
      id="selected-work"
      aria-labelledby="work-title"
    >
      <div class="section-heading">
        <span>01 / selected work</span><a href="/work"
          >all projects <span aria-hidden="true">↗</span></a
        >
      </div>
      <div class="section-intro">
        <h2 id="work-title">the questions.<br />the work behind them.</h2><p>
          solver development, propulsion analysis, and numerical flow modeling.
          each overview explains the scope and what is available to inspect.
        </p>
      </div>
      <ProjectList limit={3} />
      <a class="index-link" href="/work/portfolio-and-technical-logs"
        ><span>also in the workshop</span><strong
          >this site & the engineering record</strong
        ><span>astro / git / technical documentation</span><span
          aria-hidden="true">↗</span
        ></a
      >
    </section>
    <section
      class="portfolio-section method-section"
      aria-labelledby="method-title"
    >
      <div class="section-heading">
        <span>02 / approach</span><span
          >from a physical question to a useful record</span
        >
      </div>
      <div class="method-grid">
        <div class="method-lead">
          <h2 id="method-title">a result needs<br />a reason.</h2><p>
            the interesting part is how a model connects to the physics, where
            its assumptions hold, and what would make the answer more
            trustworthy.
          </p><a class="text-link" href="/about"
            >how i approach the work <span aria-hidden="true">↗</span></a
          >
        </div>
        <ol class="method-list">
          <li>
            <span>01</span><div>
              <h3>start with the physics.</h3><p>
                define the question, the assumptions, and the boundary
                conditions before adding complexity.
              </p>
            </div>
          </li>
          <li>
            <span>02</span><div>
              <h3>give the model a test.</h3><p>
                use small cases and numerical checks to understand what the
                method is actually doing.
              </p>
            </div>
          </li>
          <li>
            <span>03</span><div>
              <h3>leave something to inspect.</h3><p>
                keep the setup, code context, and limitations alongside a figure
                so the reasoning can be reopened.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </section>
    <section
      class="portfolio-section beyond-section"
      aria-labelledby="beyond-title"
    >
      <div class="section-heading">
        <span>03 / beyond the solver</span><span
          >the curiosity carries over</span
        >
      </div>
      <div class="beyond-grid">
        <h2 id="beyond-title">same curiosity.<br />different systems.</h2><div>
          <p>
            outside aerospace, i spend time with homelab systems and learning to
            fly. both keep the connection between theory and real-world behavior
            close.
          </p><a class="text-link" href="/systems"
            >explore the systems dashboard <span aria-hidden="true">↗</span></a
          ><a class="text-link" href="/resume"
            >view the technical profile <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </section>
    <section class="contact-plate" aria-labelledby="contact-title">
      <div class="section-heading">
        <span>have a problem worth working through?</span><span
          >let's compare notes</span
        >
      </div>
      <a class="contact-statement" href={`mailto:${profile.email}`}
        ><h2 id="contact-title">
          let's talk<br />engineering<span class="accent-dot">.</span>
        </h2><span aria-hidden="true">↗</span></a
      >
      <div class="contact-plate-bottom">
        <a href={`mailto:${profile.email}`}>{profile.email}</a><span
          >cfd / propulsion / scientific software</span
        >
      </div>
    </section>
  </main>
</BaseLayout>
