---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="field notes — colin vargas"
  description="A future home for technical notes on numerical methods, engineering decisions, and scientific software. No public entries have been released yet."
>
  <main id="main-content" tabindex="-1">
    <section class="page-intro" aria-labelledby="notes-title">
      <div class="section-heading">
        <span>field notes</span><span>the engineering notebook</span>
      </div><h1 id="notes-title">
        the thinking<br />between results<span class="accent-dot">.</span>
      </h1><div class="intro-bottom">
        <p>
          a place for numerical details, modeling decisions, and the small
          discoveries that make the next experiment better.
        </p><p class="intro-note">
          notes will include the context and artifacts needed to follow the
          work.
        </p>
      </div>
    </section>
    <section class="notes-empty" aria-labelledby="notes-status">
      <span class="empty-mark" aria-hidden="true">[ — ]</span><div>
        <span class="eyebrow">publication status</span><h2 id="notes-status">
          no public notes just yet.
        </h2><p>
          the notebook is taking shape. in the meantime, the project overviews
          describe the questions and approaches behind the work.
        </p><a class="button-link" href="/work"
          >explore the projects <span aria-hidden="true">↗</span></a
        >
      </div>
    </section>
  </main>
</BaseLayout>
