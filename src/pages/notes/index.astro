---
import BaseLayout from "../../layouts/BaseLayout.astro";
const readingPath = [
  {
    title: "how my advection update works",
    detail:
      "pick a line in the C++ update on the homepage and see what it does to one finite-volume cell.",
    href: "/",
  },
  {
    title: "what i still need to check in AMReX",
    detail:
      "i’m tracking the run data and checks i want to add to the solver write-up.",
    href: "https://github.com/urmom6009/colinvargas.com/issues/10",
  },
  {
    title: "what changed at the diffuser exit",
    detail:
      "a change of 0.01 Mach separated the best thrust and best efficiency in my sweep.",
    href: "/work/scramjet-analysis-tool",
  },
  {
    title: "what changed when i refined the mixing grid",
    detail:
      "i compared heat flow at the outlet and kinetic energy across five grids. one was a lot more sensitive to resolution.",
    href: "/work/compressible-flow-project",
  },
];
---

<BaseLayout
  title="field notes — colin vargas"
  description="Notes from my AMReX solver, propulsion model, and thermal mixing projects."
>
  <main id="main-content" tabindex="-1">
    <section class="page-intro" aria-labelledby="notes-title">
      <div class="section-heading">
        <span>notes</span>
      </div><h1 id="notes-title">
        notes from<br />my projects<span class="accent-dot">.</span>
      </h1><div class="intro-bottom">
        <p>
          i keep coming back to the parts of a project where the result
          surprised me or i had to figure out why it changed. i’ve linked a
          few of those parts below.
        </p>
      </div>
    </section>
    <section class="notes-empty" aria-labelledby="notes-status">
      <span class="empty-mark" aria-hidden="true">[ — ]</span><div>
        <h2 id="notes-status">
          what i’m working through now
        </h2><p>
          i want the single-grid advection case written up with the inputs and
          checks together. the C++ update is up on the solver page now.
        </p><a class="button-link" href="/work/adaptive-cfd-solver"
          >see the solver <span aria-hidden="true">↗</span></a
        >
      </div>
    </section>
    <section class="profile-section" aria-labelledby="reading-path-title">
      <div class="section-heading">
        <h2 id="reading-path-title">a few places to start</h2>
      </div>
      <div class="profile-projects">
        {readingPath.map((item) => (
          <article>
            <h3><a href={item.href}>{item.title} <span aria-hidden="true">↗</span></a></h3>
            <p>{item.detail}</p>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
