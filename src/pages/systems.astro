---
import BaseLayout from "../layouts/BaseLayout.astro";

const fallbackPublic = {
  generated_at: "",
  headline: "live systems data is unavailable.",
  subtitle: "the public readout will return when the api responds.",
  health_score: null,
  radar: ["website", "minecraft", "services", "storage", "backups"].map(
    (label) => ({ label, value: null }),
  ),
  cards: ["website", "minecraft", "deployments", "storage"].map(
    (label) => ({
      label,
      value: "unavailable",
      detail: "live status unavailable",
      tone: "neutral",
      href: `/systems/${label}`,
    }),
  ),
  services: [],
  deployments: [],
  storage: {
    overall: null,
    pools: [],
    redundancy: null,
    integrity: null,
  },
  environment: {
    weather: { temp: "unavailable", label: "live weather unavailable" },
    air: { aqi: null, label: "live air data unavailable", bars: [] },
  },
};

const fallbackJson = JSON.stringify(fallbackPublic).replace(/</g, "\\u003c");

const formatGenerated = (value: string) => {
  if (!value) {
    return "unavailable";
  }

  const generated = new Date(value);
  if (Number.isNaN(generated.getTime())) {
    return value;
  }

  return new Intl.DateTimeFormat("en", {
    month: "short",
    day: "numeric",
    hour: "2-digit",
    minute: "2-digit",
    timeZoneName: "short",
  })
    .format(generated)
    .toLowerCase();
};
---

<BaseLayout
  title="systems - colin vargas"
  description="Public systems telemetry for colin vargas infrastructure, with private admin controls kept off the portfolio domain."
>
  <main id="main-content" tabindex="-1">
    <p class="telemetry-notice" data-telemetry-notice role="status">
      live public telemetry is unavailable. no current health values are shown.
    </p>
    <section
      class="resume-hero page-scene systems-hero"
      aria-labelledby="systems-title"
      data-scroll-chapter
    >
      <div class="section-heading">
        <span>urmom.systems</span>
        <span>public dashboard</span>
      </div>

      <div class="resume-hero-grid">
        <div>
          <h1 id="systems-title">systems, with the status in context.</h1>
          <p>
            a read-only view of the homelab. live responses are labeled, and
            missing telemetry is left unavailable.
          </p>
        </div>

        <aside class="systems-live-card" aria-live="polite">
          <span>system health</span>
          <strong
            ><span data-health-score>—</span><small data-health-unit></small></strong
          >
          <p data-status-line>live systems data unavailable.</p>

          <dl class="systems-meta">
            <div>
              <dt>source</dt>
              <dd data-source>api unavailable</dd>
            </div>
            <div>
              <dt>updated</dt>
              <dd data-generated>
                {formatGenerated(fallbackPublic.generated_at)}
              </dd>
            </div>
          </dl>
        </aside>
      </div>
    </section>

    <section
      class="resume-section page-scene systems-control-section"
      aria-labelledby="systems-control-title"
      data-scroll-chapter
    >
      <div class="section-heading">
        <span id="systems-control-title">systems board</span>
        <span>public view</span>
      </div>

      <div class="systems-dashboard" data-systems-root>
        <section
          class="systems-panel systems-primary-panel"
          aria-labelledby="systems-summary-title"
          data-build-step="1"
        >
          <div class="systems-panel-head">
            <span>public snapshot</span>
            <small>sanitized telemetry</small>
          </div>

          <div class="systems-snapshot-hero">
            <div
              class="systems-score-ring"
              style="--score-angle: 0deg"
              data-score-ring
            >
              <span data-health-score>—</span>
              <small>health score</small>
            </div>

            <div class="systems-snapshot-copy">
              <span class="systems-state-chip">read-only signal</span>
              <h2 id="systems-summary-title" data-headline>
                {fallbackPublic.headline}
              </h2>
              <p data-subtitle>{fallbackPublic.subtitle}</p>
            </div>
          </div>

          <dl class="systems-snapshot-stats">
            <div>
              <dt>services</dt>
              <dd data-service-count>unavailable</dd>
            </div>
            <div>
              <dt>source</dt>
              <dd data-source>api unavailable</dd>
            </div>
            <div>
              <dt>updated</dt>
              <dd data-generated>
                {formatGenerated(fallbackPublic.generated_at)}
              </dd>
            </div>
          </dl>

          <div
            class="systems-radar"
            data-radar
            aria-label="public systems scorecard"
          >
            {
              fallbackPublic.radar.map((item) => (
                <div class="systems-radar-row">
                  <span>{item.label}</span>
                  <div class="systems-radar-track" aria-hidden="true">
                    <span
                      class="systems-radar-fill"
                      style="--value: 0%"
                    />
                  </div>
                  <strong>—</strong>
                </div>
              ))
            }
          </div>

          <div class="systems-environment" data-environment>
            <div>
              <span>weather</span>
              <strong data-weather-temp
                >{fallbackPublic.environment.weather.temp}</strong
              >
              <p data-weather-label>
                {fallbackPublic.environment.weather.label}
              </p>
            </div>
            <div>
              <span>air</span>
              <strong
                ><span data-air-aqi>unavailable</span><span data-air-unit></span></strong
              >
              <p data-air-label>{fallbackPublic.environment.air.label}</p>
            </div>
          </div>

          <div
            class="systems-air-bars"
            data-air-bars
            aria-label="air quality trend"
          >
            <p>live air quality trend unavailable.</p>
          </div>

          <div class="systems-boundary-note" data-build-step="6">
            <span>admin endpoint</span>
            <p>
              the admin side is a separate private endpoint. this page does not
              render restart controls, hostnames, peer names, raw logs, or
              network internals.
            </p>
          </div>
        </section>

        <section
          class="systems-card-grid"
          data-cards
          aria-label="headline system cards"
          data-build-step="2"
        >
          {
            fallbackPublic.cards.map((card) => (
              <a class={`systems-card tone-${card.tone}`} href={card.href}>
                <span>{card.label}</span>
                <strong>{card.value}</strong>
                <p>{card.detail}</p>
                <small>view readout</small>
              </a>
            ))
          }
        </section>

        <section
          class="systems-panel systems-service-panel"
          aria-labelledby="systems-services-title"
          data-build-step="3"
        >
          <div class="systems-panel-head">
            <span id="systems-services-title">public signals</span>
            <small data-service-count>unavailable</small>
          </div>

          <div class="systems-service-list" data-services>
            <p>live service status unavailable.</p>
          </div>
        </section>

        <section
          class="systems-panel systems-deploy-panel"
          aria-labelledby="systems-deploy-title"
          data-build-step="4"
        >
          <div class="systems-panel-head">
            <span id="systems-deploy-title">build trail</span>
            <small>latest visible refs</small>
          </div>

          <div class="systems-timeline" data-deployments>
            <p>live deployment history unavailable.</p>
          </div>
        </section>

        <section
          class="systems-panel systems-storage-panel"
          aria-labelledby="systems-storage-title"
          data-build-step="5"
        >
          <div class="systems-panel-head">
            <span id="systems-storage-title">storage pool health</span>
            <small data-storage-summary>unavailable</small>
          </div>

          <div class="systems-storage-score">
            <strong><span data-storage-overall>—</span><span data-storage-unit></span></strong>
            <p data-storage-context>live storage data unavailable.</p>
          </div>

          <div class="systems-storage-list" data-storage-pools>
            <p>live pool status unavailable.</p>
          </div>
        </section>
      </div>
    </section>
  </main>

  <script
    is:inline
    id="systems-fallback-data"
    type="application/json"
    set:html={fallbackJson}
  />
  <script is:inline>
    (() => {
      const fallbackNode = document.getElementById("systems-fallback-data");
      const fallback = JSON.parse(fallbackNode?.textContent || "{}");
      const endpoint = "/systems/api/public";
      const refreshMs = 60_000;

      const clamp = (value, min = 0, max = 100) =>
        Math.min(Math.max(Number(value) || 0, min), max);
      const metric = (value) =>
        value !== null &&
        value !== undefined &&
        value !== "" &&
        Number.isFinite(Number(value))
          ? clamp(value)
          : null;
      const lower = (value, fallbackText = "unavailable") =>
        String(value ?? fallbackText).toLowerCase();
      const isOnline = (status) =>
        ["online", "running", "active"].includes(lower(status));

      const textAll = (selector, value) => {
        document.querySelectorAll(selector).forEach((node) => {
          node.textContent = String(value);
        });
      };

      const make = (tag, className, text) => {
        const node = document.createElement(tag);
        if (className) {
          node.className = className;
        }
        if (text !== undefined && text !== null) {
          node.textContent = String(text);
        }
        return node;
      };
      const emptyMessage = (message) => make("p", "", message);
      const cardHref = (label, fallbackHref) => {
        if (fallbackHref) {
          return fallbackHref;
        }
        const normalized = lower(label);
        if (normalized.includes("minecraft")) {
          return "/systems/minecraft";
        }
        if (normalized.includes("deploy")) {
          return "/systems/deployments";
        }
        if (normalized.includes("storage")) {
          return "/systems/storage";
        }
        if (normalized.includes("website") || normalized.includes("web")) {
          return "/systems/website";
        }
        return "/systems";
      };

      const formatGenerated = (value) => {
        if (!value) {
          return "unavailable";
        }

        const generated = new Date(value);
        if (Number.isNaN(generated.getTime())) {
          return lower(value);
        }

        return new Intl.DateTimeFormat("en", {
          month: "short",
          day: "numeric",
          hour: "2-digit",
          minute: "2-digit",
          timeZoneName: "short",
        })
          .format(generated)
          .toLowerCase();
      };

      const normalize = (incoming) => {
        const source = incoming && typeof incoming === "object" ? incoming : {};
        const environment = {
          weather: {},
          air: {},
          ...(source.environment || {}),
        };

        return {
          ...source,
          radar: Array.isArray(source.radar) ? source.radar : [],
          cards: Array.isArray(source.cards) ? source.cards : [],
          services: Array.isArray(source.services) ? source.services : [],
          deployments: Array.isArray(source.deployments)
            ? source.deployments
            : [],
          storage: {
            ...(source.storage || {}),
            pools: Array.isArray(source.storage?.pools)
              ? source.storage.pools
              : [],
          },
          environment,
        };
      };

      const renderRadar = (radar) => {
        const target = document.querySelector("[data-radar]");
        if (!target) {
          return;
        }

        const rows = (radar || []).map((item) => {
            const row = make("div", "systems-radar-row");
            row.append(make("span", "", lower(item.label)));

            const track = make("div", "systems-radar-track");
            track.setAttribute("aria-hidden", "true");
            const fill = make("span", "systems-radar-fill");
            const value = metric(item.value);
            fill.style.setProperty("--value", `${value ?? 0}%`);
            track.append(fill);

            row.append(track, make("strong", "", value === null ? "—" : `${value}%`));
            return row;
          });
        target.replaceChildren(...(rows.length ? rows : [emptyMessage("live scorecard unavailable.")]));
      };

      const renderCards = (cards) => {
        const target = document.querySelector("[data-cards]");
        if (!target) {
          return;
        }

        const rows = (cards || []).map((card) => {
            const tone = ["good", "warn", "bad"].includes(lower(card.tone))
              ? lower(card.tone)
              : "neutral";
            const item = make("a", `systems-card tone-${tone}`);
            item.href = cardHref(card.label, card.href);
            item.append(
              make("span", "", lower(card.label)),
              make("strong", "", lower(card.value)),
              make("p", "", lower(card.detail)),
              make("small", "", "view readout"),
            );
            return item;
          });
        target.replaceChildren(...(rows.length ? rows : [emptyMessage("live system cards unavailable.")]));
      };

      const renderServices = (services) => {
        const target = document.querySelector("[data-services]");
        if (!target) {
          return;
        }

        const items = services || [];
        if (!items.length) {
          textAll("[data-service-count]", "unavailable");
          textAll("[data-status-line]", "live systems data unavailable.");
          target.replaceChildren(emptyMessage("live service status unavailable."));
          return;
        }

        const online = items.filter((service) => isOnline(service.status)).length;
        textAll(
          "[data-service-count]",
          `${online}/${items.length} online`,
        );
        textAll(
          "[data-status-line]",
          `${online} of ${items.length} read-only signals reporting online.`,
        );

        target.replaceChildren(
          ...items.map((service) => {
            const status = lower(service.status);
            const row = make("article", "systems-service-row");
            const dot = make("span", `systems-status-dot is-${status}`);
            const copy = make("div");
            copy.append(
              make("strong", "", lower(service.name)),
              make("small", "", lower(service.net || "public signal")),
            );
            const state = make("span", "", status);
            const meter = make("i");
            const load = [service.cpu, service.mem]
              .map(metric)
              .filter((value) => value !== null);
            if (load.length) {
              meter.style.setProperty("--load", `${Math.max(...load)}%`);
            }
            row.append(dot, copy, state, meter);
            return row;
          }),
        );
      };

      const renderDeployments = (deployments) => {
        const target = document.querySelector("[data-deployments]");
        if (!target) {
          return;
        }

        const rows = (deployments || []).map((deployment) => {
            const row = make("article");
            const copy = make("div");
            copy.append(
              make("strong", "", lower(deployment.name)),
              make(
                "p",
                "",
                `${lower(deployment.when)} / ${lower(deployment.duration)}`,
              ),
            );
            row.append(
              make("span", "", lower(deployment.status)),
              copy,
              make("small", "", lower(deployment.ref)),
            );
            return row;
          });
        target.replaceChildren(...(rows.length ? rows : [emptyMessage("live deployment history unavailable.")]));
      };

      const renderStorage = (storage) => {
        const pools = Array.isArray(storage?.pools) ? storage.pools : [];
        const overall = metric(storage?.overall);
        textAll("[data-storage-overall]", overall === null ? "—" : overall);
        textAll("[data-storage-unit]", overall === null ? "" : "%");
        textAll("[data-storage-context]", storage?.redundancy || storage?.integrity
          ? `${lower(storage?.redundancy)} / ${lower(storage?.integrity)}`
          : "live storage data unavailable.");
        textAll("[data-storage-summary]", lower(storage?.integrity));

        const target = document.querySelector("[data-storage-pools]");
        if (!target) {
          return;
        }

        const rows = pools.map((pool) => {
            const row = make("article");
            const copy = make("div");
            copy.append(
              make("strong", "", lower(pool.name)),
              make("span", "", lower(pool.state)),
            );
            const meter = make("i");
            const health = metric(pool.health);
            if (health !== null) {
              meter.style.setProperty("--health", `${health}%`);
            }
            row.append(copy, meter);
            return row;
          });
        target.replaceChildren(...(rows.length ? rows : [emptyMessage("live pool status unavailable.")]));
      };

      const renderEnvironment = (environment) => {
        const weather = environment?.weather || {};
        const air = environment?.air || {};
        textAll("[data-weather-temp]", lower(weather.temp));
        textAll("[data-weather-label]", lower(weather.label || weather.source));
        const aqi = metric(air.aqi);
        textAll("[data-air-aqi]", aqi === null ? "unavailable" : aqi);
        textAll("[data-air-unit]", aqi === null ? "" : " aqi");
        textAll("[data-air-label]", lower(air.label));

        const bars = Array.isArray(air.bars) ? air.bars : [];
        const target = document.querySelector("[data-air-bars]");
        if (!target) {
          return;
        }

        const columns = bars.map((bar) => {
            const item = make("span");
            item.style.setProperty(
              "--bar",
              `${clamp(Number(bar) * 7, 8, 100)}%`,
            );
            return item;
          });
        target.replaceChildren(...(columns.length ? columns : [emptyMessage("live air quality trend unavailable.")]));
      };

      const render = (rawData, sourceLabel) => {
        const notice = document.querySelector("[data-telemetry-notice]");
        if (notice)
          notice.textContent =
            sourceLabel === "live api"
              ? "live public telemetry — read-only snapshot from the systems api."
              : "live public telemetry is unavailable. no current health values are shown.";
        const data = normalize(rawData);
        const score = metric(data.health_score);
        textAll("[data-health-score]", score === null ? "—" : score);
        textAll("[data-health-unit]", score === null ? "" : "%");
        textAll("[data-headline]", lower(data.headline));
        textAll("[data-subtitle]", lower(data.subtitle));
        textAll("[data-generated]", formatGenerated(data.generated_at));
        textAll("[data-source]", sourceLabel);
        document
          .querySelector("[data-score-ring]")
          ?.style.setProperty("--score-angle", `${(score ?? 0) * 3.6}deg`);
        renderRadar(data.radar);
        renderCards(data.cards);
        renderServices(data.services);
        renderDeployments(data.deployments);
        renderStorage(data.storage);
        renderEnvironment(data.environment);
      };

      const fetchLive = async () => {
        try {
          const response = await fetch(endpoint, {
            headers: { accept: "application/json" },
            cache: "no-store",
          });

          if (!response.ok) {
            throw new Error(`systems api returned ${response.status}`);
          }

          const data = await response.json();
          if (
            !data ||
            typeof data !== "object" ||
            !Array.isArray(data.cards) ||
            !Array.isArray(data.radar)
          ) {
            throw new Error("systems api returned an invalid snapshot");
          }
          render(data, "live api");
        } catch {
          render(fallback, "api unavailable");
        }
      };

      render(fallback, "api unavailable");
      fetchLive();
      window.setInterval(fetchLive, refreshMs);
    })();
  </script>
</BaseLayout>
