---
import BaseLayout from "../layouts/BaseLayout.astro";
import { systemsSections } from "../data/systemsSections";
import "../styles/systems-refinement.css";

const fallbackPublic = {
  headline: "public systems readout",
  subtitle: "the available signals are shown with their source and report time.",
};
const sections = Object.entries(systemsSections);

---

<BaseLayout
  title="systems - colin vargas"
  description="Public systems telemetry for colin vargas infrastructure, with private admin controls kept off the portfolio domain."
>
  <main id="main-content" class="systems-page" tabindex="-1">
    <p class="telemetry-notice" data-telemetry-notice role="status">
      the public feed is unavailable. the four system records below are still available.
    </p>
    <section
      class="resume-hero page-scene systems-hero"
      aria-labelledby="systems-title"
      data-scroll-chapter
    >
      <div class="section-heading">
        <span>urmom.systems</span>
        <span>public dashboard</span>
      </div>

      <div class="resume-hero-grid">
        <div>
          <h1 id="systems-title">systems, with the status in context.</h1>
          <p>
            a read-only view of the homelab. reported signals carry their source
            and time; missing readings stay unavailable.
          </p>
        </div>

        <aside class="systems-live-card" data-health-panel aria-live="polite" hidden>
          <span data-health-label>reported health score</span>
          <strong
            ><span data-health-score>—</span><small data-health-unit></small></strong
          >
          <p data-status-line></p>
        </aside>
      </div>
    </section>

    <section class="resume-section page-scene systems-index-section" aria-labelledby="systems-index-title">
      <div class="section-heading">
        <span id="systems-index-title">system records</span>
        <span>four public surfaces</span>
      </div>
      <div class="systems-index">
        {
          sections.map(([slug, section], index) => (
            <a href={`/systems/${slug}`} class="systems-index-row">
              <span class="systems-index-number">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <span class="systems-index-eyebrow">{section.eyebrow}</span>
                <h2>{section.title}</h2>
                <p>{section.summary}</p>
              </div>
              <strong data-index-status={slug} hidden></strong>
              <span aria-hidden="true">↗</span>
            </a>
          ))
        }
      </div>
      <p class="systems-feed-meta" data-feed-meta hidden>
        <span data-feed-label>latest public snapshot</span> / systems api / reported <time data-generated>time unreported</time>
      </p>
      <p class="systems-public-boundary">
        this is a read-only surface. restart controls, hostnames, peer names, raw logs, and network internals stay on the private admin side.
      </p>
    </section>

    <section
      class="resume-section page-scene systems-control-section"
      aria-labelledby="systems-control-title"
      data-live-section
      hidden
    >
      <div class="section-heading">
        <span id="systems-control-title">public readout</span>
        <span>source / public api</span>
      </div>

      <div class="systems-dashboard" data-systems-root>
        <section
          class="systems-panel systems-primary-panel"
          aria-labelledby="systems-summary-title"
          data-summary-panel
          hidden
        >
          <div class="systems-panel-head">
            <span>public snapshot</span>
            <small>sanitized telemetry</small>
          </div>

          <div class="systems-snapshot-hero">
            <div
              class="systems-score-ring"
              style="--score-angle: 0deg"
              data-score-ring
              hidden
            >
              <span data-health-score>—</span>
              <small>health score</small>
            </div>

            <div class="systems-snapshot-copy">
              <span class="systems-state-chip">read-only signal</span>
              <h2 id="systems-summary-title" data-headline>
                {fallbackPublic.headline}
              </h2>
              <p data-subtitle>{fallbackPublic.subtitle}</p>
            </div>
          </div>

          <div
            class="systems-radar"
            data-radar
            aria-label="public systems scorecard"
            hidden
          >
          </div>

          <div class="systems-environment" data-environment hidden>
            <div data-weather hidden>
              <span>weather</span>
              <strong data-weather-temp></strong>
              <p data-weather-label></p>
            </div>
            <div data-air hidden>
              <span>air</span>
              <strong><span data-air-aqi></span><span data-air-unit></span></strong>
              <p data-air-label></p>
            </div>
          </div>

          <div
            class="systems-air-bars"
            data-air-bars
            aria-label="air quality trend"
            hidden
          >
          </div>
        </section>

        <section
          class="systems-panel systems-service-panel"
          aria-labelledby="systems-services-title"
          data-services-panel
          hidden
        >
          <div class="systems-panel-head">
            <span id="systems-services-title">public signals</span>
            <small data-service-count></small>
          </div>
          <div class="systems-service-list" data-services></div>
        </section>

        <section
          class="systems-panel systems-deploy-panel"
          aria-labelledby="systems-deploy-title"
          data-deploy-panel
          hidden
        >
          <div class="systems-panel-head">
            <span id="systems-deploy-title">build trail</span>
            <small>latest visible refs</small>
          </div>

          <div class="systems-timeline" data-deployments></div>
        </section>

        <section
          class="systems-panel systems-storage-panel"
          aria-labelledby="systems-storage-title"
          data-storage-panel
          hidden
        >
          <div class="systems-panel-head">
            <span id="systems-storage-title">storage pool health</span>
            <small data-storage-summary></small>
          </div>

          <div class="systems-storage-score" data-storage-score hidden>
            <strong><span data-storage-overall>—</span><span data-storage-unit></span></strong>
            <p data-storage-context></p>
          </div>

          <div class="systems-storage-list" data-storage-pools></div>
        </section>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const endpoint = "/systems/api/public";
      const refreshMs = 60_000;
      const staleAfterMs = 15 * 60_000;
      const query = (selector) => document.querySelector(selector);
      const show = (selector, visible) => {
        const node = query(selector);
        if (node) node.hidden = !visible;
      };
      const textAll = (selector, value) => {
        document.querySelectorAll(selector).forEach((node) => {
          node.textContent = String(value);
        });
      };
      const plain = (value, backup = "") =>
        typeof value === "string" || typeof value === "number"
          ? String(value).trim()
          : backup;
      const present = (value) =>
        Boolean(plain(value)) &&
        !["unavailable", "unknown", "—", "null"].includes(plain(value).toLowerCase());
      const numeric = (value) => {
        if (typeof value !== "number" && (typeof value !== "string" || !value.trim())) return null;
        const number = Number(value);
        return Number.isFinite(number) ? number : null;
      };
      const metric = (value) => {
        const number = numeric(value);
        return number !== null && number >= 0 && number <= 100 ? number : null;
      };
      const make = (tag, className = "", value) => {
        const node = document.createElement(tag);
        if (className) node.className = className;
        if (value !== undefined) node.textContent = String(value);
        return node;
      };
      const formatGenerated = (value) => {
        const date = new Date(value);
        if (!value || Number.isNaN(date.getTime())) return "time unreported";
        return new Intl.DateTimeFormat("en", {
          month: "short",
          day: "numeric",
          year: "numeric",
          hour: "2-digit",
          minute: "2-digit",
          timeZoneName: "short",
        }).format(date).toLowerCase();
      };
      const snapshotState = (value) => {
        if (!value) return "unreported";
        const time = new Date(value).getTime();
        if (Number.isNaN(time)) return "unreported";
        const age = Date.now() - time;
        if (age > staleAfterMs) return "historical";
        if (age < -staleAfterMs) return "future";
        return "recent";
      };
      const normalize = (incoming) => {
        const data = incoming && typeof incoming === "object" && !Array.isArray(incoming)
          ? incoming
          : {};
        return {
          ...data,
          cards: Array.isArray(data.cards) ? data.cards : [],
          radar: Array.isArray(data.radar) ? data.radar : [],
          services: Array.isArray(data.services) ? data.services : [],
          deployments: Array.isArray(data.deployments) ? data.deployments : [],
          storage: data.storage && typeof data.storage === "object" ? data.storage : {},
          environment: data.environment && typeof data.environment === "object"
            ? data.environment
            : {},
        };
      };
      const sectionKey = (label) => {
        const name = plain(label).toLowerCase();
        if (name.includes("minecraft")) return "minecraft";
        if (name.includes("deploy")) return "deployments";
        if (name.includes("storage")) return "storage";
        if (name.includes("website") || name.includes("web")) return "website";
        return null;
      };
      const renderIndex = (cards) => {
        document.querySelectorAll("[data-index-status]").forEach((node) => {
          node.hidden = true;
          node.textContent = "";
        });
        for (const card of cards) {
          const key = sectionKey(card?.label);
          if (!key || !present(card?.value)) continue;
          const node = query(`[data-index-status="${key}"]`);
          if (!node) continue;
          node.textContent = plain(card.value);
          node.hidden = false;
        }
      };
      const renderRadar = (items) => {
        const target = query("[data-radar]");
        if (!target) return;
        const rows = items.map((item) => {
          const value = metric(item.value);
          const row = make("div", "systems-radar-row");
          row.append(make("span", "", plain(item.label)));
          const track = make("div", "systems-radar-track");
          track.setAttribute("aria-hidden", "true");
          const fill = make("span", "systems-radar-fill");
          fill.style.setProperty("--value", `${value}%`);
          track.append(fill);
          row.append(track, make("strong", "", `${value}%`));
          return row;
        });
        target.replaceChildren(...rows);
        target.hidden = rows.length === 0;
      };
      const renderServices = (items) => {
        show("[data-services-panel]", items.length > 0);
        const target = query("[data-services]");
        if (!target || !items.length) return;
        const online = items.filter((item) =>
          ["online", "running", "active"].includes(plain(item.status).toLowerCase()),
        ).length;
        textAll("[data-service-count]", `${online}/${items.length} reported online`);
        target.replaceChildren(...items.map((service) => {
          const status = plain(service.status).toLowerCase();
          const stateClass = ["online", "running", "active", "offline", "failed"].includes(status)
            ? ` is-${status}`
            : "";
          const row = make("article", "systems-service-row");
          const dot = make("span", `systems-status-dot${stateClass}`);
          dot.setAttribute("aria-hidden", "true");
          const copy = make("div");
          copy.append(make("strong", "", plain(service.name)));
          const state = make("span", "", status);
          row.append(dot, copy, state);
          return row;
        }));
      };
      const renderDeployments = (items) => {
        show("[data-deploy-panel]", items.length > 0);
        const target = query("[data-deployments]");
        if (!target || !items.length) return;
        target.replaceChildren(...items.map((deployment) => {
          const row = make("article");
          const copy = make("div");
          copy.append(make("strong", "", plain(deployment.name)));
          const context = [deployment.when, deployment.duration].filter(present).map((value) => plain(value));
          if (context.length) copy.append(make("p", "", context.join(" / ")));
          row.append(make("span", "", plain(deployment.status, "reported")), copy);
          if (present(deployment.ref)) row.append(make("small", "", plain(deployment.ref)));
          return row;
        }));
      };
      const renderStorage = (storage, pools, overall) => {
        const redundancy = present(storage.redundancy) ? plain(storage.redundancy) : "";
        const integrity = present(storage.integrity) ? plain(storage.integrity) : "";
        const hasStorage = overall !== null || pools.length > 0 || Boolean(redundancy || integrity);
        show("[data-storage-panel]", hasStorage);
        show("[data-storage-score]", overall !== null);
        if (!hasStorage) return;
        textAll("[data-storage-summary]", integrity || "public pool status");
        textAll("[data-storage-overall]", overall === null ? "" : overall);
        textAll("[data-storage-unit]", overall === null ? "" : "%");
        textAll("[data-storage-context]", [redundancy, integrity].filter(Boolean).join(" / "));
        const target = query("[data-storage-pools]");
        if (!target) return;
        target.replaceChildren(...pools.map((pool) => {
          const row = make("article");
          const copy = make("div");
          copy.append(make("strong", "", plain(pool.name)));
          if (present(pool.state)) copy.append(make("span", "", plain(pool.state)));
          const health = metric(pool.health);
          row.append(copy);
          if (health !== null) {
            const meter = make("i");
            meter.setAttribute("aria-hidden", "true");
            meter.style.setProperty("--health", `${health}%`);
            row.append(meter);
          }
          return row;
        }));
      };
      const renderEnvironment = (weather, air, bars, aqi) => {
        const hasWeather = present(weather.temp);
        show("[data-environment]", hasWeather || aqi !== null);
        show("[data-weather]", hasWeather);
        show("[data-air]", aqi !== null);
        if (hasWeather) {
          textAll("[data-weather-temp]", plain(weather.temp));
          textAll("[data-weather-label]", plain(weather.label || weather.source, "public weather reading"));
        }
        if (aqi !== null) {
          textAll("[data-air-aqi]", aqi);
          textAll("[data-air-unit]", " aqi");
          textAll("[data-air-label]", plain(air.label, "public air reading"));
        }
        const target = query("[data-air-bars]");
        if (!target) return;
        target.hidden = bars.length === 0;
        target.replaceChildren(...bars.map((bar) => {
          const item = make("span");
          item.style.setProperty("--bar", `${Math.min(Math.max(bar * 7, 8), 100)}%`);
          return item;
        }));
      };
      const renderUnavailable = (message) => {
        const notice = query("[data-telemetry-notice]");
        if (notice) {
          notice.hidden = false;
          notice.textContent = message ||
            "the public feed is unavailable. the four system records below are still available.";
        }
        show("[data-health-panel]", false);
        show("[data-feed-meta]", false);
        show("[data-live-section]", false);
        renderIndex([]);
      };
      const render = (incoming) => {
        const data = normalize(incoming);
        const score = metric(data.health_score);
        const radar = data.radar.filter((item) => item && present(item.label) && metric(item.value) !== null);
        const services = data.services.filter((item) => item && present(item.name) && present(item.status));
        const deployments = data.deployments.filter((item) => item && present(item.name) && (present(item.status) || present(item.ref)));
        const storage = data.storage;
        const pools = (Array.isArray(storage.pools) ? storage.pools : []).filter((pool) => pool && present(pool.name));
        const overall = metric(storage.overall);
        const weather = data.environment.weather || {};
        const air = data.environment.air || {};
        const airReading = numeric(air.aqi);
        const aqi = airReading !== null && airReading >= 0 && airReading <= 500 ? airReading : null;
        const bars = (Array.isArray(air.bars) ? air.bars : [])
          .map(numeric)
          .filter((value) => value !== null && value >= 0);
        const hasCard = data.cards.some((card) => card && sectionKey(card.label) && present(card.value));
        const hasSummary = score !== null || radar.length > 0 || present(weather.temp) || aqi !== null || bars.length > 0;
        const hasStorage = overall !== null || pools.length > 0 || present(storage.redundancy) || present(storage.integrity);
        const hasPanel = hasSummary || services.length > 0 || deployments.length > 0 || hasStorage;
        if (!hasCard && !hasPanel) {
          renderUnavailable("the public api responded, but returned no reportable readings. the four system records below are still available.");
          return;
        }
        renderIndex(data.cards);
        const reported = formatGenerated(data.generated_at);
        const state = snapshotState(data.generated_at);
        textAll("[data-generated]", reported);
        textAll("[data-feed-label]", state === "historical" ? "historical public snapshot" : "latest public snapshot");
        const generatedNode = query("[data-generated]");
        if (generatedNode) {
          if (reported === "time unreported") generatedNode.removeAttribute("datetime");
          else generatedNode.setAttribute("datetime", new Date(data.generated_at).toISOString());
        }
        show("[data-feed-meta]", true);
        show("[data-live-section]", hasPanel);
        const notice = query("[data-telemetry-notice]");
        if (notice) {
          notice.hidden = state === "recent";
          notice.textContent = state === "historical"
            ? "the last public snapshot is older than 15 minutes. current status is unverified."
            : state === "future"
              ? "the snapshot time is ahead of this browser's clock. current status is unverified."
              : "the public api responded, but did not report a snapshot time. current status is unverified.";
        }
        show("[data-health-panel]", score !== null);
        if (score !== null) {
          textAll("[data-health-label]", state === "historical" ? "historical health score" : "reported health score");
          textAll("[data-health-score]", score);
          textAll("[data-health-unit]", "%");
          textAll("[data-status-line]", services.length
            ? `${services.filter((item) => ["online", "running", "active"].includes(plain(item.status).toLowerCase())).length} of ${services.length} signals reported online.`
            : "aggregate public score reported by the api.");
        }
        show("[data-summary-panel]", hasSummary);
        show("[data-score-ring]", score !== null);
        query("[data-score-ring]")?.style.setProperty("--score-angle", `${(score ?? 0) * 3.6}deg`);
        textAll("[data-headline]", present(data.headline) ? plain(data.headline) : "public systems readout");
        textAll("[data-subtitle]", present(data.subtitle) ? plain(data.subtitle) : "the available signals are shown with their source and report time.");
        renderRadar(radar);
        renderServices(services);
        renderDeployments(deployments);
        renderStorage(storage, pools, overall);
        renderEnvironment(weather, air, bars, aqi);
      };
      const fetchLive = async () => {
        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(), 8_000);
        try {
          const response = await fetch(endpoint, {
            headers: { accept: "application/json" },
            cache: "no-store",
            signal: controller.signal,
          });
          if (!response.ok) throw new Error(`systems api returned ${response.status}`);
          const data = await response.json();
          if (!data || typeof data !== "object" || Array.isArray(data)) {
            throw new Error("systems api returned an invalid snapshot");
          }
          render(data);
        } catch {
          renderUnavailable();
        } finally {
          window.clearTimeout(timeout);
        }
      };
      renderUnavailable();
      fetchLive();
      window.setInterval(fetchLive, refreshMs);
    })();
  </script>
</BaseLayout>
