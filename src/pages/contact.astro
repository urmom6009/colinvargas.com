---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/portfolio";
const contacts = [
  {
    label: "email",
    href: `mailto:${profile.email}`,
    detail: profile.email,
    note: "for project questions and professional conversations",
  },
  {
    label: "github",
    href: profile.github,
    detail: "urmom6009",
    note: "public repositories and source history",
  },
  {
    label: "linkedin",
    href: profile.linkedin,
    detail: "colin vargas",
    note: "professional profile and connections",
  },
];
---

<BaseLayout
  title="contact — colin vargas"
  description="Get in touch with Colin Vargas about computational fluid dynamics, propulsion, aerospace engineering, and scientific software."
>
  <main id="main-content" tabindex="-1">
    <section class="page-intro" aria-labelledby="contact-title">
      <div class="section-heading">
        <span>start a conversation</span><span>america/phoenix</span>
      </div><h1 id="contact-title">
        let's talk<br />engineering<span class="accent-dot">.</span>
      </h1><div class="intro-bottom">
        <p>
          a question about a project, a research problem, or an opportunity to
          build something useful. email is the best place to start.
        </p><p class="intro-note">
          areas of interest / computational fluid dynamics, propulsion,
          numerical methods, and scientific software.
        </p>
      </div>
    </section>
    <section class="contact-channels" aria-label="contact channels">
      {
        contacts.map((contact, i) => (
          <a href={contact.href}>
            <>
              <span class="eyebrow">
                0{i + 1} / {contact.label}
              </span>
              <strong>{contact.detail}</strong>
              <span>{contact.note}</span>
              <span class="channel-arrow" aria-hidden="true">
                ↗
              </span>
            </>
          </a>
        ))
      }
    </section>
    <div class="contact-key">
      <span class="eyebrow">openpgp fingerprint</span><code
        >91C5 AA19 9233 EDCE 5328 E2BD 25E6 5DF0 9F37 A6FB</code
      >
    </div>
  </main>
</BaseLayout>
