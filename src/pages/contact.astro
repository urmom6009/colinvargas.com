---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/portfolio";
const contacts = [
  {
    label: "email",
    href: `mailto:${profile.email}`,
    detail: profile.email,
    note: "this is the best way to reach me",
  },
  {
    label: "github",
    href: profile.github,
    detail: "urmom6009",
    note: "code i’ve shared",
  },
  {
    label: "linkedin",
    href: profile.linkedin,
    detail: "colin vargas",
    note: "connect with me here",
  },
];
---

<BaseLayout
  title="contact — colin vargas"
  description="Email me about my projects or Fall 2027 PhD research in combustion, spray modeling, and aviation propulsion."
>
  <main id="main-content" tabindex="-1">
    <section class="page-intro" aria-labelledby="contact-title">
      <div class="section-heading">
        <span>contact</span>
      </div><h1 id="contact-title">
        hey, let’s talk<span class="accent-dot">.</span>
      </h1><div class="intro-bottom">
        <p>
          i’m looking for a PhD group for fall 2027. if you’re working on
          combustion, spray modeling, or aviation propulsion, i’d love to
          hear what you’re trying to figure out. questions about anything on
          the site are welcome too.
        </p><p class="intro-note">
          <a class="text-link" href="/resume">view my technical profile ↗</a>
        </p>
      </div>
    </section>
    <section class="contact-channels" aria-label="contact channels">
      {
        contacts.map((contact, i) => (
          <a href={contact.href}>
            <>
              <span class="eyebrow">
                0{i + 1} / {contact.label}
              </span>
              <strong>{contact.detail}</strong>
              <span>{contact.note}</span>
              <span class="channel-arrow" aria-hidden="true">
                ↗
              </span>
            </>
          </a>
        ))
      }
    </section>
    <div class="contact-key">
      <span class="eyebrow">openpgp fingerprint</span><code
        >91C5 AA19 9233 EDCE 5328 E2BD 25E6 5DF0 9F37 A6FB</code
      >
    </div>
  </main>
</BaseLayout>
