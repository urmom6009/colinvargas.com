---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects, profile } from "../data/portfolio";
const experience = [
  {
    role: "in-service engineering intern",
    organization: "Honeywell Aerospace / may–aug 2024",
    detail:
      "i pulled together case notes and emulator output for gas-turbine and avionics investigations, and kept track of who was following up on 23 open cases.",
  },
  {
    role: "aerodynamics team lead",
    organization: "ASU Solar Devils / 2023–2025",
    detail:
      "i led a 10-student team through the aeroshell design, Ansys CFD, design reviews, procurement, and fitting the shell to the car.",
  },
  {
    role: "grader and instructional assistant",
    organization: "Arizona State University / 2025–2026",
    detail:
      "i reviewed students’ work in numerical integration, interpolation, and linear algebra, including whether they’d picked a method that made sense for the problem.",
  },
];
const capabilities = [
  {
    title: "computational methods",
    detail:
      "i’ve used finite volumes for advection and finite differences for thermal mixing, and checked how results change as the grid gets finer.",
  },
  {
    title: "scientific software",
    detail:
      "i write C++ for my single-grid AMReX solver and keep notes tied to the Git revision i ran.",
  },
  {
    title: "combustion & propulsion",
    detail:
      "i’ve used NASA CEA for fuel blends and MATLAB to see how flight and engine inputs change predicted thrust and efficiency.",
  },
];
---

<BaseLayout
  title="technical profile — colin vargas"
  description="My education, projects, and engineering experience, in a format you can print or save as a PDF."
>
  <main id="main-content" tabindex="-1" class="technical-profile">
    <section class="page-intro" aria-labelledby="resume-title">
      <div class="section-heading">
        <span>technical profile</span><button
          class="print-profile"
          data-print-profile
          type="button"
          hidden>print this profile ↗</button
        >
      </div><h1 id="resume-title">
        colin vargas<span class="accent-dot">.</span>
      </h1><div class="intro-bottom">
        <p>
          i studied aerospace engineering at ASU. i’m looking for a fall
          2027 PhD group working on combustion, CFD, or aviation propulsion.
        </p><div class="project-facts">
          <a href={`mailto:${profile.email}`}>{profile.email}</a><a
            href={profile.github}>github / urmom6009 ↗</a
          ><a href={profile.linkedin}>linkedin / colin vargas ↗</a>
        </div>
      </div>
    </section>
    <section class="profile-section" aria-labelledby="capabilities-title">
      <h2 id="capabilities-title" class="eyebrow">what i work with</h2><div
        class="profile-capabilities"
      >
        {
          capabilities.map((capability) => (
            <article>
              <>
                <h3>{capability.title}</h3>
                <p>{capability.detail}</p>
              </>
            </article>
          ))
        }
      </div>
    </section>
    <section class="profile-section" aria-labelledby="education-title">
      <h2 id="education-title" class="eyebrow">education</h2>
      <div class="profile-projects">
        <article>
          <h3>Arizona State University</h3>
          <span class="eyebrow">b.s.e. aerospace engineering (aeronautics) / may 2025</span>
          <p>minor in french. additional graduate study in aerospace engineering, 2025–2026.</p>
        </article>
      </div>
    </section>
    <section class="profile-section" aria-labelledby="experience-title">
      <div class="section-heading">
        <h2 id="experience-title">experience</h2>
      </div>
      <div class="profile-projects">
        {experience.map((item) => (
          <article>
            <h3>{item.role}</h3>
            <span class="eyebrow">{item.organization}</span>
            <p>{item.detail}</p>
          </article>
        ))}
      </div>
    </section>
    <section class="profile-section" aria-labelledby="profile-projects-title">
      <div class="section-heading">
        <h2 id="profile-projects-title">projects</h2>
      </div><div class="profile-projects">
        {
          projects.map((project) => (
            <article>
              <>
                <div>
                  <>
                    <h3>
                      <a href={`/work/${project.slug}`}>
                        {project.title} <span aria-hidden="true">↗</span>
                      </a>
                    </h3>
                    <span class="eyebrow">
                      {project.context} / {project.status}
                    </span>
                  </>
                </div>
                <p>{project.summary}</p>
                <span class="project-tools">{project.tools.join(" / ")}</span>
              </>
            </article>
          ))
        }
      </div>
    </section>
    <section class="profile-section profile-note">
      <a class="text-link" href="/contact"
        >get in touch <span aria-hidden="true">↗</span></a
      >
    </section>
  </main>
</BaseLayout>
<script>
  const print = document.querySelector<HTMLButtonElement>(
    "[data-print-profile]",
  );
  if (print) {
    print.hidden = false;
    print.addEventListener("click", () => window.print());
  }
</script>
