---
import BrandMark from "./BrandMark.astro";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { href: "/work", label: "work" },
  { href: "/about", label: "about" },
  { href: "/notes", label: "notes" },
  { href: "/resume", label: "profile" },
  { href: "/contact", label: "contact" },
];
---

<header class="site-header">
  <div class="header-inner">
    <a
      class="wordmark"
      href="/"
      aria-label="colin vargas home"
      aria-current={path === "/" ? "page" : undefined}
    >
      <BrandMark />
      <span>colin vargas</span>
    </a>
    <nav aria-label="primary navigation">
      {
        links.map(({ href, label }) => (
          <a
            class="nav-link"
            href={href}
            aria-current={
              path === href
                ? "page"
                : path.startsWith(`${href}/`)
                  ? "location"
                  : undefined
            }
          >
            {label}
          </a>
        ))
      }
    </nav>
    <button
      class="theme-toggle"
      type="button"
      aria-label="dark mode"
      aria-pressed="false"
      title="dark mode"
      hidden
    >
      <span class="theme-disc" aria-hidden="true"></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    width: min(
      var(--page-width, 1120px),
      calc(100% - 2 * var(--page-gutter, clamp(20px, 4vw, 48px)))
    );
    min-height: 72px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    margin-right: auto;
    font: 500 21px/1 var(--font-sans);
    letter-spacing: -0.045em;
    white-space: nowrap;
  }
  nav {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.6vw, 32px);
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    font: 400 14px/1.4 var(--font-mono);
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }
  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-link[aria-current] {
    color: var(--ink);
    text-decoration-line: underline;
    text-decoration-color: var(--accent);
  }
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
  }
  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    background: var(--surface);
    color: var(--ink);
  }
  .theme-disc {
    width: 18px;
    height: 18px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    background: linear-gradient(to right, transparent 50%, currentColor 50%);
  }
  .theme-toggle[aria-pressed="true"] .theme-disc {
    background: linear-gradient(to left, transparent 50%, currentColor 50%);
  }
  @media (max-width: 640px) {
    .site-header {
      position: relative;
    }
    .header-inner {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 0;
      padding-top: 6px;
    }
    .wordmark {
      font-size: 19px;
    }
    nav {
      grid-area: 2 / 1 / 3 / -1;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 0 12px;
      border-top: 1px solid var(--line);
    }
    .nav-link {
      font-size: 13px;
    }
    .theme-toggle {
      grid-area: 1 / 2;
    }
  }
  @media print {
    .site-header {
      display: none;
    }
  }
</style>
