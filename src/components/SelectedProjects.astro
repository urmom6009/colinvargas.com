---
import { projects } from "../data/portfolio";
---

<ul class="selected-projects" role="list">
  {projects.map((project) => (
    <li>
      <a href={`/work/${project.slug}`}>
        <span class="project-name">{project.title}</span>
        <span class="project-record">{project.record}</span>
        <span class="project-pointer" aria-hidden="true">→</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .selected-projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(32px, 5vw, 80px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    border-top: 1px solid var(--line);
  }

  li:nth-last-child(-n + 2) {
    border-bottom: 1px solid var(--line);
  }

  a {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-content: start;
    gap: 8px 20px;
    padding: clamp(18px, 2.2vw, 32px) 0;
  }

  .project-name {
    color: var(--ink);
    font-size: clamp(24px, 2.4vw, 38px);
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .project-record {
    grid-column: 1;
    color: var(--muted);
    font: 14px/1.5 var(--font-mono);
  }

  .project-pointer {
    grid-column: 2;
    grid-row: 1;
    align-self: center;
    color: var(--accent);
    font: 24px/1 var(--font-sans);
  }

  a:is(:hover, :focus-visible) .project-name {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  @media (max-width: 700px) {
    .selected-projects {
      grid-template-columns: minmax(0, 1fr);
    }

    li:nth-last-child(2) {
      border-bottom: 0;
    }
  }
</style>
