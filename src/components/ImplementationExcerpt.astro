---
import { solverImplementation } from "../data/solverImplementation";
import "../styles/implementation-study.css";
import AdvectionView from "./AdvectionView.astro";
interface Props {
  detailed?: boolean;
  animate?: boolean;
}
const { detailed = false, animate = false } = Astro.props;
---

<div
  class:list={[
    "implementation-container",
    { "implementation-scroll": animate },
  ]}
  data-implementation-track={animate ? "" : undefined}
>
  <figure
    id={detailed ? "implementation" : undefined}
    class:list={[
      "implementation-feature",
      { "implementation-detailed": detailed },
    ]}
  >
    <div class="implementation-heading">
      <span>from the implementation</span><span>c++ / amrex</span>
    </div>
    <h2>the advection baseline.</h2>
    <p class="implementation-summary">
      first-order upwind. face fluxes in, updated cell averages out.
    </p>
    <div class="implementation-stage">
      <div class="source-fragment" data-source-pane>
        <div class="source-file">
          <span>advance.cpp</span><span>upwindUpdate()</span>
        </div>
        <pre
          tabindex="0"
          aria-label="C++ excerpt from the actual upwind update"><code>{solverImplementation.code}</code></pre>
      </div>
      {animate && <AdvectionView />}
    </div>
    <dl class="implementation-facts">
      <div><dt>domain</dt><dd>2d · periodic</dd></div><div>
        <dt>current solver</dt><dd>single-level</dd>
      </div>
    </dl>
    <figcaption>
      <span
        >implementation excerpt · revision {
          solverImplementation.revision.slice(0, 7)
        }</span
      >
      {detailed && <span class="source-path">{solverImplementation.file}</span>}
      {
        animate && (
          <span class="implementation-scroll-hint">
            scroll to follow the update <span aria-hidden="true">↓</span>
          </span>
        )
      }
    </figcaption>
    {
      detailed && (
        <p class="implementation-note">
          this is the finite-volume update in the current solver. adaptive
          refinement is a planned extension. the excerpt documents the
          implementation; it does not establish convergence or validation.
        </p>
      )
    }
  </figure>
</div>
<script>
  import { enhanceImplementationStudies } from "../scripts/implementationScroll";
  enhanceImplementationStudies();
</script>
