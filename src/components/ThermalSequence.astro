---
const media = "/media/mixing-chamber";
---

<figure id="mixing-chamber" class="thermal-figure" data-thermal-sequence>
  <div class="plot-plate">
    <div class="plot-heading">
      <h2>thermal mixing chamber</h2>
      <span>Re = 100 · Pr = 2</span>
    </div>
    <div class="plot">
      <div class="y-scale" aria-hidden="true"><span>3</span><span>2</span><span>1</span><span>0</span></div>
      <div class="field">
        <video controls playsinline muted preload="none"
          width="796" height="596" src={`${media}/temperature.mp4`}
          poster={`${media}/temperature-poster.webp`}
          aria-label="Temperature in the mixing chamber from simulation time 0 to 5. The upper paddle cools the flow and the lower paddle heats it. Black is coolest and white is hottest.">
          <a href={`${media}/temperature.mp4`}>open the temperature movie</a>
        </video>
        <canvas width="796" height="596" data-velocity={`${media}/velocity.bin`} hidden aria-hidden="true"></canvas>
      </div>
      <div class="temperature-scale" aria-hidden="true">
        <span class="scale-title">T</span>
        <svg viewBox="0 0 4 596" preserveAspectRatio="none">
          <image href={`${media}/temperature-scale.webp`} width="596" height="4" transform="translate(0 596) rotate(-90)" />
        </svg>
        <div><span>3</span><span>2</span><span>1</span><span>0</span></div>
      </div>
      <div class="x-scale" aria-hidden="true"><span>0</span><span>1</span><span>2</span><span>3</span><span>4</span></div>
      <span class="x-label" aria-hidden="true">x</span><span class="y-label" aria-hidden="true">y</span>
    </div>
    <div class="time-readout" data-controls hidden>
      <button type="button" data-play aria-label="Play simulation from the start">play</button>
      <input type="range" aria-label="Simulation time" min="0" step="1" value="0" />
      <span class="sample-value" data-time></span>
    </div>
    <label class="overlay-control" hidden>
      <input type="checkbox" checked aria-describedby="velocity-note" />
      velocity arrows
    </label>
    <p class="figure-note" id="velocity-note" hidden>
      arrows estimate direction and speed from the colors in my u and v movies.
      each component’s scale runs from −1.5 to +1.5.
    </p>
    <p class="figure-note" data-media-status role="status" hidden></p>
  </div>
  <figcaption>
    <span>nondimensional temperature · 0 ≤ t ≤ 5</span>
    <a href="/work/compressible-flow-project#case-evidence">see the study <span aria-hidden="true">↗</span></a>
  </figcaption>
</figure>

<script>
  import { enhanceMixingPlayer } from "../scripts/mixingPlayer";
  document.querySelectorAll<HTMLElement>("[data-thermal-sequence]").forEach(enhanceMixingPlayer);
</script>

<style>
  .thermal-figure {
    min-width: 0;
    container-type: inline-size;
    font: 13px/1.45 var(--font-mono);
  }
  .plot-plate {
    --plot-ink: #edf0e5;
    --plot-muted: #bdc4b7;
    --plot-rule: #525d52;
    padding: clamp(16px, 2vw, 30px);
    color: var(--plot-ink);
    background: #202923;
    border: 1px solid var(--plot-rule);
    color-scheme: dark;
  }
  .plot-heading, .time-readout, figcaption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 16px;
    flex-wrap: wrap;
  }
  .plot-heading {
    padding-bottom: 14px;
    border-bottom: 1px solid var(--plot-rule);
  }
  h2 {
    font: 400 clamp(23px, 2.1vw, 32px)/1.05 var(--font-sans);
    letter-spacing: -0.035em;
  }
  .plot-heading > span, .plot, .time-readout {
    color: var(--plot-muted);
  }
  .plot {
    position: relative;
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr) 24px;
    grid-template-rows: auto auto;
    gap: 6px 9px;
    padding: 22px 0 18px;
    font-variant-numeric: tabular-nums;
  }
  .field {
    position: relative;
    min-width: 0;
    align-self: start;
    background: #202923;
    display: block;
    width: 100%;
    aspect-ratio: 796 / 596;
    overflow: hidden;
  }
  .field video,
  .field canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .field canvas { pointer-events: none; }
  .y-scale, .temperature-scale > div {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    line-height: 1;
  }
  .y-scale {
    align-items: end;
  }
  .temperature-scale {
    display: flex;
    position: relative;
    justify-content: space-between;
  }
  .temperature-scale > svg {
    height: 100%;
    width: 8px;
    position: absolute;
    overflow: hidden;
  }
  .temperature-scale > div {
    margin-left: auto;
  }
  .scale-title, .y-label {
    position: absolute;
    line-height: 1;
  }
  .scale-title {
    top: -17px;
    left: 0;
  }
  .y-label {
    top: 4px;
    left: 5px;
  }
  .x-scale {
    display: flex;
    grid-column: 2;
    justify-content: space-between;
  }
  .x-label {
    align-self: start;
  }
  .time-readout {
    align-items: center;
    gap: 8px 14px;
    padding-top: 8px;
    border-top: 1px solid var(--plot-rule);
  }
  .time-readout button {
    min-width: 6ch;
    min-height: 36px;
    padding: 0;
    border: 0;
    background: transparent;
    font: inherit;
    text-align: left;
    color: var(--plot-ink);
  }
  .time-readout input {
    flex: 1;
    min-width: 44px;
    height: 36px;
    margin: 0;
  }
  .plot-plate input { accent-color: #cedac8; cursor: pointer; }
  .plot-plate :is(input, button):focus-visible {
    outline: 2px solid #cedac8;
    outline-offset: 2px;
  }
  .sample-value {
    color: var(--plot-ink);
    font-variant-numeric: tabular-nums;
  }
  .overlay-control {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 32px;
    cursor: pointer;
  }
  .overlay-control input { margin: 0; width: 16px; height: 16px; }
  .figure-note {
    color: var(--plot-muted);
    max-width: 60ch;
    margin: 2px 0 0;
    font: 13px/1.45 var(--font-sans);
  }
  figcaption {
    color: var(--muted);
    margin-top: 10px;
  }
  figcaption a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  figcaption a:hover {
    color: var(--accent);
  }
  @container (max-width: 380px) {
    .time-readout { display: grid; grid-template-columns: auto 1fr; gap: 0 8px; }
    .time-readout input { grid-row: 2; grid-column: 1 / -1; width: 100%; }
    .sample-value { grid-row: 1; grid-column: 2; text-align: right; }
  }
  @media (max-width: 380px) {
    .plot-plate { padding: 14px; }
    .time-readout { gap: 8px; }
  }
</style>
