---
import { createTransportFrames, referenceCase, referenceCell } from "../lib/advection";
import CellFluxView from "./CellFluxView.astro";

const frames = createTransportFrames();
const initial = frames[0];
const final = frames[frames.length - 1];
const n = referenceCase.resolution;
const cellPlotY = n - 1 - referenceCell.j;
const views = [
  {
    key: "start",
    frame: initial,
    note: "the Gaussian pulse starts left of center, at (0.25, 0.50).",
  },
  {
    key: "final",
    frame: final,
    note: "the pulse moves up and right. the first-order upwind update spreads it and lowers the peak.",
  },
].map(({ key, frame, note }) => {
  // Both snapshots use the same 8-bit opacity scale. Group equal shades so the
  // static figure needs only one SVG path per shade instead of one node per cell.
  const shades = new Map<number, string[]>();
  frame.field.forEach((value, index) => {
    const shade = Math.round(value * 255);
    if (!shade) return;
    if (!shades.has(shade)) shades.set(shade, []);
    const x = index % n;
    const y = n - 1 - Math.floor(index / n);
    shades.get(shade)!.push(`M${x} ${y}h1v1h-1z`);
  });
  return { key, time: frame.time.toFixed(2), note, shades, peak: Math.max(...frame.field).toFixed(3) };
});
---

<div class="advection-view" data-advection-view>
  <CellFluxView initial={initial} />
  <section class="advection-global" data-global-view aria-labelledby="reference-field-title">
    <div class="advection-view-heading">
      <h3 id="reference-field-title">transport across the grid</h3>
      <span>{n} × {n} periodic grid</span>
    </div>
    <fieldset class="advection-comparison">
      <legend class="field-reader-only">compare the scalar field at two times</legend>
      {views.map(({ key, time }) => (
        <>
          <input type="radio" class="field-choice" name="advection-time" value={key}
            id={`advection-time-${key}`} aria-controls={`advection-frame-${key}`} checked={key === "final"} />
          <label for={`advection-time-${key}`}>{key} <span>t = {time}</span></label>
        </>
      ))}
      {views.map(({ key, time, shades, peak, note }) => (
        <div class="advection-frame" data-reference-frame={key} id={`advection-frame-${key}`}>
          <div class="field-chart">
            <svg class="advection-static" viewBox={`0 0 ${n} ${n}`} role="img"
              aria-label={`Scalar field at t = ${time} on the unit square. Both axes run from zero to one. Stronger color indicates a higher cell average.`}
              shape-rendering="crispEdges">
              {Array.from(shades, ([shade, cells]) => (
                <path fill="currentColor" fill-opacity={shade / 255} d={cells.join("")} />
              ))}
              {key === "start" && (
                <g class="inspected-field-cell" aria-hidden="true">
                  <path d={`M${referenceCell.i + 1} ${cellPlotY}l3 -3h3`} />
                  <rect x={referenceCell.i} y={cellPlotY} width="1" height="1" />
                </g>
              )}
            </svg>
            <span class="field-y-axis" aria-hidden="true">y ↑</span>
            <div class="field-scale" aria-hidden="true"><span>φ = 1</span><i></i><span>0</span></div>
            <div class="field-axis" aria-hidden="true"><span>0</span><span>x → 1</span></div>
          </div>
          <div class="field-reading">
            <span>peak φ = {peak}</span>
            {key === "start" && (
              <span class="field-cell-key">inspected cell ({referenceCell.i}, {referenceCell.j})</span>
            )}
            <p>{note}</p>
          </div>
        </div>
      ))}
    </fieldset>
    <p class="advection-provenance">
      reference calculation <span>u = ({referenceCase.velocity.join(", ")}) · CFL {referenceCase.cfl}</span>
    </p>
  </section>
</div>
