---
import { createTransportFrames, referenceCase } from "../lib/advection";
const frames = createTransportFrames();
const final = frames[frames.length - 1];
const n = referenceCase.resolution;
const cells = Array.from(final.field, (value, index) => ({
  x: index % n,
  y: n - 1 - Math.floor(index / n),
  value,
})).filter((cell) => cell.value > 0.002);
---

<div class="advection-view" data-advection-view>
  <div class="advection-view-heading">
    <h3>the same update, in space.</h3><span>φ / transported scalar</span>
  </div>
  <div
    class="advection-body"
    role="img"
    aria-label="A computed Gaussian scalar profile transported to the right on a 64 by 64 periodic grid, with numerical diffusion from first-order upwind."
  >
    <div class="advection-domain">
      <div class="advection-field">
        <svg
          viewBox={`0 0 ${n} ${n}`}
          aria-hidden="true"
          class="advection-static"
          shape-rendering="crispEdges"
        >
          {
            cells.map((cell) => (
              <rect
                x={cell.x}
                y={cell.y}
                width="1"
                height="1"
                fill="currentColor"
                fill-opacity={cell.value.toFixed(4)}
              />
            ))
          }
        </svg>
        <canvas width={n} height={n} data-advection-canvas aria-hidden="true"
        ></canvas>
      </div>
      <span class="axis-y">y</span><span class="axis-origin">0</span><span
        class="axis-end">1 / x</span
      >
    </div>
    <div class="advection-description">
      <span class="eyebrow">prescribed velocity</span>
      <strong>u = (1, 0)</strong>
      <svg class="advection-direction" viewBox="0 0 100 14" aria-hidden="true"
        ><path
          d="M1 7 H96 M90 2 L96 7 L90 12"
          fill="none"
          stroke="currentColor"
          stroke-width="1"></path></svg
      >
      <p>the profile moves right. its spread comes from numerical diffusion.</p>
      <span class="eyebrow">reference time</span>
      <span class="advection-time"
        >t = <span data-reference-time>{final.time.toFixed(3)}</span></span
      >
    </div>
  </div>
  <div class="advection-case">
    <span>{n} × {n} / periodic / cfl {referenceCase.cfl}</span><span
      >unit square · dimensionless</span>
  </div>
  <p class="advection-provenance">
    reference calculation of the displayed update · illustrative initial
    condition
  </p>
</div>
