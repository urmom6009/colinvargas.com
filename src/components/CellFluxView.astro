---
import {
  inspectCell,
  referenceCase,
  referenceCell,
  type TransportFrame,
} from "../lib/advection";
import { implementationSteps, scalarLabel, stepValue } from "../data/implementationSteps";
interface Props {
  initial: TransportFrame;
}
const { initial } = Astro.props;
const n = referenceCase.resolution;
const budget = inspectCell(
  initial.field,
  n,
  referenceCase.velocity,
  referenceCell.dt,
  referenceCell.i,
  referenceCell.j,
);
const faces = [
  { key: "Fx_lo", name: "left",   edge: "M40 40v40", arrow: "M17 60h32m-6 -5 6 5-6 5" },
  { key: "Fx_hi", name: "right",  edge: "M80 40v40", arrow: "M71 60h32m-6 -5 6 5-6 5" },
  { key: "Fy_lo", name: "bottom", edge: "M40 80h40", arrow: "M60 103V71m-5 6 5-6 5 6" },
  { key: "Fy_hi", name: "top",    edge: "M40 40h40", arrow: "M60 49V17m-5 6 5-6 5 6" },
] as const;
---

<div class="advection-cell" data-cell-view>
  <div class="cell-result" id="upwind-cell-diagram">
    <svg class="cell-flux-diagram" viewBox="0 0 120 120" aria-hidden="true">
      <path class="cell-grid" d="M40 0v120M80 0v120M0 40h120M0 80h120" />
      <rect class="target-cell" x="40" y="40" width="40" height="40" />
      {faces.map(({ key, edge, arrow }) => (
        <g class="cell-face" data-face={key}>
          <path d={edge} />
          <path d={arrow} />
        </g>
      ))}
    </svg>
    {implementationSteps.map((step) => (
      <div class="cell-reading" id={`cell-reading-${step.key}`} data-cell-step={step.key} hidden={step.key !== "new_fab"}>
        <h3>{step.title}</h3>
        <span class="step-value" data-step-value>{scalarLabel(stepValue(step.key, budget))}</span>
        <p>{step.explanation}</p>
      </div>
    ))}
  </div>
  <details class="cell-details">
    <summary>calculation details</summary>
    <p>cell ({referenceCell.i}, {referenceCell.j}) · t = 0 · Δt = {referenceCell.dt.toFixed(6)}</p>
    <dl aria-label="face fluxes">
      {faces.map(({ key, name }) => (
        <div><dt>{name} · {key}</dt><dd>{scalarLabel(budget[key])}</dd></div>
      ))}
    </dl>
    <div class="cell-equation">
      <span>φ new = φ old − dtdivF</span>
      <span>{scalarLabel(budget.nextPhi)} ≈ {scalarLabel(budget.phiC)} − ({scalarLabel(budget.dtdivF)})</span>
    </div>
  </details>
</div>
