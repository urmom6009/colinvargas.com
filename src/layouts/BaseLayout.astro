---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import { profile } from "../data/portfolio";
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "colin vargas — aerospace engineering & scientific software",
  description = "Aerospace engineering portfolio of Colin Vargas. Projects in computational fluid dynamics, propulsion analysis, and scientific software, with scope and publication status.",
} = Astro.props;
const canonical = new URL(
  Astro.url.pathname.replace(/\/+$/, "") || "/",
  Astro.site || "https://colinvargas.com",
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f1ea" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/PPNeueMontreal-Book.otf"
      as="font"
      type="font/otf"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="colin vargas" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <script is:inline>
      (() => {
        const storageKey = "colinvargas-theme";
        const media = window.matchMedia("(prefers-color-scheme: dark)");
        const stored = () => {
          try {
            return localStorage.getItem(storageKey);
          } catch {
            return null;
          }
        };
        const apply = (theme) => {
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", theme === "dark" ? "#141815" : "#f4f1ea");
        };
        const preferred = () =>
          ["light", "dark"].includes(stored())
            ? stored()
            : media.matches
              ? "dark"
              : "light";
        apply(preferred());
        window.__setColinTheme = (theme) => {
          try {
            localStorage.setItem(storageKey, theme);
          } catch {}
          apply(theme);
        };
        media.addEventListener("change", () => {
          if (!["light", "dark"].includes(stored())) apply(preferred());
        });
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">skip to content</a>
    <SiteHeader />
    <slot />
    <footer class="site-ribbon" aria-label="site footer">
      <div class="ribbon-copy">
        <a href="/">colin vargas<span class="accent-dot">.</span></a><span
          >aerospace / software / systems</span
        >
      </div>
      <div class="footer-links">
        <a href={profile.github}>github ↗</a><a href={profile.linkedin}
          >linkedin ↗</a
        ><a href="/systems">systems</a><a href={`mailto:${profile.email}`}
          >email ↗</a
        >
      </div>
      <div class="footer-bottom">
        <span>built with curiosity. documented with care.</span><a
          href={profile.source}
          >site source <span aria-hidden="true">↗</span></a
        ><span>america/phoenix</span>
      </div>
    </footer>
    <button
      class="theme-toggle"
      type="button"
      aria-label="switch color theme"
      aria-pressed="false"
      hidden
      ><span class="theme-icon" aria-hidden="true">◐</span><span
        data-theme-label>theme</span
      ></button
    >
    <script is:inline>
      (() => {
        const header = document.querySelector(".site-header");
        const syncHeader = () =>
          header?.classList.toggle("is-scrolled", window.scrollY > 16);
        syncHeader();
        window.addEventListener("scroll", syncHeader, { passive: true });
        const button = document.querySelector(".theme-toggle");
        if (!button) return;
        button.hidden = false;
        const syncButton = () => {
          const dark = document.documentElement.dataset.theme === "dark";
          button.setAttribute("aria-pressed", String(dark));
          button.setAttribute(
            "aria-label",
            dark ? "switch to light theme" : "switch to dark theme",
          );
          button.querySelector("[data-theme-label]").textContent = dark
            ? "light"
            : "dark";
        };
        button.addEventListener("click", () => {
          window.__setColinTheme?.(
            document.documentElement.dataset.theme === "dark"
              ? "light"
              : "dark",
          );
          syncButton();
        });
        window
          .matchMedia("(prefers-color-scheme: dark)")
          .addEventListener("change", syncButton);
        syncButton();
      })();
    </script>
  </body>
</html>
